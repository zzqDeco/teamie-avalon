# Production configuration template for /srv/teamie-avalon/config/production.env
# NEVER commit real TEAMIE_APP_ID or TEAMIE_APP_SIGNING_SECRET values to Git.

PUBLIC_HTTPS_PORT=9444
TLS_CERT_DIR=/srv/teamie-avalon/tls
TEAMIE_ORIGIN=https://120.25.210.202
PHASE_TIMEOUT_SEC=90

# Obtain these once when creating the "avalon" app draft at https://120.25.210.202/app/developers
TEAMIE_APP_ID=00000000-0000-4000-8000-replace_with_app_id
TEAMIE_APP_SIGNING_SECRET=tmsec_replace_with_real_signing_secret
